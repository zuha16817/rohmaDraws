# Example Environment Configuration (Public Template)
# Anything prefixed VITE_ is bundled into the public JS shipped to every visitor's
# browser — NEVER put a secret behind a VITE_ variable. Only the Stripe
# *publishable* key belongs here; it is designed by Stripe to be public.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Server-only secrets. These are read with getenv() in PHP and are never sent
# to the browser. Set them in your hosting control panel's environment
# variables, not in a client-side .env used by the Vite build.
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
ADMIN_PASSWORD=your_secure_admin_password_here

DB_HOST=localhost
DB_NAME=rohmadraws_db
DB_USER=root
DB_PASS=
